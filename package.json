{
  "name": "grokdesk",
  "version": "0.1.0",
  "private": true,
  "description": "GrokDesk — an unofficial cross-platform Grok Build desktop workspace",
  "type": "module",
  "main": "electron/main.mjs",
  "author": "GrokDesk contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/KechoCN/GrokDesk",
  "repository": { "type": "git", "url": "https://github.com/KechoCN/GrokDesk.git" },
  "bugs": { "url": "https://github.com/KechoCN/GrokDesk/issues" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node scripts/run-tests.mjs",
    "test:smoke": "node scripts/run-tests.mjs --smoke",
    "validate:release": "node scripts/validate-release.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "package": "node scripts/package.mjs",
    "package:dir": "node scripts/package.mjs --dir",
    "package:win": "node scripts/package.mjs --platform win",
    "package:mac": "node scripts/package.mjs --platform mac",
    "package:linux": "node scripts/package.mjs --platform linux"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.17.0",
    "node-pty": "1.1.0",
    "radix-ui": "1.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "smol-toml": "^1.8.0",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "shadcn": "4.1.1",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.2",
    "vite": "8.3.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
